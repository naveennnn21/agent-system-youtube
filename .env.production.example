# =============================================================================
# YouTube Shorts AI Agent — Environment Variables (Production)
# =============================================================================
# Copy this file to .env.production and fill in real secrets before deploying.
#   cp .env.production.example .env.production
# =============================================================================

# --- Application --------------------------------------------------------------
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# --- Database (PostgreSQL — use managed service URLs) -------------------------
# These must be set to your actual database connection strings.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/youtube_shorts_agent
DATABASE_SYNC_URL=postgresql://user:password@host:5432/youtube_shorts_agent
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Redis (use managed Redis URLs) -------------------------------------------
REDIS_URL=redis://user:password@host:6379/0
REDIS_MAX_CONNECTIONS=20
CELERY_BROKER_URL=redis://user:password@host:6379/1
CELERY_RESULT_BACKEND=redis://user:password@host:6379/2

# --- CORS (restrict to your dashboard domain) --------------------------------
CORS_ORIGINS=["https://your-dashboard-domain.com","https://your-api-domain.com"]

# --- API Keys (all required for full functionality) ---------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FLUX_API_KEY=
STABILITY_API_KEY=

# --- YouTube API Keys ---------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# --- Optional: Notification Webhook ------------------------------------------
NOTIFICATIONS_ENABLED=false
NOTIFICATION_WEBHOOK_URL=

# --- Rate Limiting --------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTOMATION=10/minute
RATE_LIMIT_ANALYTICS=20/minute
